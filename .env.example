# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- HTTP -------------------------------------------------------------------
PORT=8787
APP_URL=http://localhost:8787
NODE_ENV=development

# --- storage ----------------------------------------------------------------
DATABASE_PATH=./data/app.db
# Public prefix for the 261 remote skill videos and 402 covers. The source
# values in src/data/skills.json look like /previews/<slug>.mp4.
MEDIA_BASE_URL=https://growclawa.oss-cn-beijing.aliyuncs.com/skillskr

# --- sessions ---------------------------------------------------------------
# 32+ random bytes, hex or base64. Generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_DAYS=30
# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# --- Google OAuth -----------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# Authorised redirect URI: http://localhost:8787/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback

# --- outbound egress proxy (optional) ----------------------------------------
# Google's token exchange happens SERVER-side, so the server itself must be able
# to reach accounts.google.com / oauth2.googleapis.com. If it cannot (mainland
# China, locked-down VPC), point this at an HTTP(S) proxy. Node's built-in fetch
# ignores HTTPS_PROXY, so this variable is what actually wires the proxy in.
#   OUTBOUND_PROXY_URL=http://127.0.0.1:7890
#   OUTBOUND_PROXY_URL=socks5://user:pass@host:1080   (undici supports http/https only)
OUTBOUND_PROXY_URL=

# --- Waffo Pancake ----------------------------------------------------------
# Dashboard -> API & Development -> "Create an API Key" section
#   Merchant ID: first row above the key list (MER_...)
#   Private Key: the RSA PEM, downloaded once at key creation
WAFFO_MERCHANT_ID=MER_your_merchant_id

# Paste the PEM in ONE of these three forms:
#   1. escaped newlines
#      WAFFO_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----"
#   2. base64 of the whole PEM file (recommended)
#      WAFFO_PRIVATE_KEY_BASE64=LS0tLS1CRUdJTi...
#   3. a path to the .pem on disk (handy for local dev)
#      WAFFO_PRIVATE_KEY_FILE=./keys/pancake-private.pem
WAFFO_PRIVATE_KEY=
WAFFO_PRIVATE_KEY_BASE64=
WAFFO_PRIVATE_KEY_FILE=

# Store created via `npm run pancake:setup` (or Dashboard -> Settings -> Store Profile)
WAFFO_STORE_ID=STO_your_store_id
# Optional product overrides. The app ships with this store's IDs as defaults,
# so a fresh /data volume links its plans on boot without a one-off command.
# WAFFO_PRODUCT_PRO_MONTHLY=PROD_...
# WAFFO_PRODUCT_PRO_YEARLY=PROD_...
# WAFFO_PRODUCT_LIFETIME=PROD_...
# test | prod  — which environment this key operates in
WAFFO_ENVIRONMENT=test
# Optional: override the API base URL (defaults to https://api.waffo.ai)
# WAFFO_BASE_URL=

# --- billing -----------------------------------------------------------------
# Default currency offered at checkout (ISO 4217).
DEFAULT_CURRENCY=USD
# Where Pancake sends the buyer after a successful payment.
CHECKOUT_SUCCESS_URL=http://localhost:8787/?billing=success
# Keep access while a renewal is being retried (past_due grace period).
PAST_DUE_GRACE_DAYS=7
